# ==========================================
# InterviewAI Environment Configuration
# ==========================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Database (Leave as is for Docker, or your MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017/interviewai

# Frontend Client URL (For CORS & socket origins)
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=super_secure_random_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Optional: system falls back to resilient offline Mock AI if omitted)
GEMINI_API_KEY=

# Stripe Billing (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend Email Service (Optional: for sending post-interview PDF/summary emails)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
